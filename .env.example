# ScamShield AI Environment Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional AI Providers (transparent fallback to rule-based heuristic engine if not set)
# To use Google Gemini:
GEMINI_API_KEY=
# Or to use OpenAI:
OPENAI_API_KEY=

# Optional Google Safe Browsing Lookup v4 API Key
GOOGLE_SAFE_BROWSING_API_KEY=

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60
